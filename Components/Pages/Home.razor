@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject IConfiguration Configuration
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger

<PageTitle>Home</PageTitle>

<h1>File Upload</h1>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0">Upload Files</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="this" OnValidSubmit="UploadFiles">
                        <div class="mb-3">
                            <label for="fileInput" class="form-label">Select Files</label>
                            <InputFile id="fileInput"
                                       class="form-control"
                                       multiple
                                       OnChange="OnFileSelectionChanged"
                                       accept="*/*" />
                            <div class="form-text">You can select multiple files at once.</div>
                        </div>

                        @if (selectedFiles.Any())
                        {
                            <div class="mb-3">
                                <h5>Selected Files:</h5>
                                <ul class="list-group">
                                    @foreach (var file in selectedFiles)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>@file.Name</span>
                                            <span class="badge bg-secondary rounded-pill">@FormatFileSize(file.Size)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="mb-3">
                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@(!selectedFiles.Any() || isUploading)">
                                @if (isUploading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Uploading...</span>
                                }
                                else
                                {
                                    <span>Upload Files</span>
                                }
                            </button>
                        </div>
                    </EditForm>

                    @if (!string.IsNullOrEmpty(uploadMessage))
                    {
                        <div class="alert @(uploadSuccess ? "alert-success" : "alert-danger")" role="alert">
                            @uploadMessage
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<IBrowserFile> selectedFiles = new();
    private bool isUploading = false;
    private string uploadMessage = string.Empty;
    private bool uploadSuccess = false;
    private const int maxFileSize = 10 * 1024 * 1024; // 10MB per file

    private void OnFileSelectionChanged(InputFileChangeEventArgs e)
    {
        selectedFiles.Clear();
        selectedFiles.AddRange(e.GetMultipleFiles());
        uploadMessage = string.Empty;
        Logger.LogInformation("Files selected: {FileCount} files", selectedFiles.Count);

        foreach (var file in selectedFiles)
        {
            Logger.LogDebug("Selected file: {FileName}, Size: {FileSize} bytes, ContentType: {ContentType}",
                file.Name, file.Size, file.ContentType);
        }

        StateHasChanged();
    }

    private async Task UploadFiles()
    {
        Logger.LogInformation("Starting file upload process. File count: {FileCount}", selectedFiles.Count);

        if (!selectedFiles.Any())
        {
            Logger.LogWarning("Upload attempted with no files selected");
            return;
        }

        isUploading = true;
        uploadMessage = string.Empty;
        StateHasChanged();

        try
        {
            var uploadUrl = Configuration["UPLOAD_URL"] ?? "http://localhost:7151/api/UploadAndProcess";
            Logger.LogInformation("Upload URL from configuration: {UploadUrl}", uploadUrl);

            using var content = new MultipartFormDataContent();
            
            // Explicitly set the boundary for the multipart content
            var boundary = Guid.NewGuid().ToString("N");
            content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("multipart/form-data")
            {
                Parameters = { new System.Net.Http.Headers.NameValueHeaderValue("boundary", boundary) }
            };
            
            Logger.LogInformation("Creating multipart form data content with boundary: {Boundary}", boundary);

            foreach (var file in selectedFiles)
            {
                Logger.LogDebug("Processing file for upload: {FileName}, Size: {FileSize}", file.Name, file.Size);

                var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
                content.Add(fileContent, "files", file.Name);

                Logger.LogDebug("Added file to multipart content: {FileName}", file.Name);
            }

            // Log the actual content-type being sent
            Logger.LogInformation("Content-Type header: {ContentType}", content.Headers.ContentType?.ToString());

            Logger.LogInformation("Sending POST request to {UploadUrl}", uploadUrl);
            var response = await HttpClient.PostAsync(uploadUrl, content);

            Logger.LogInformation("Received response: StatusCode={StatusCode}, ReasonPhrase={ReasonPhrase}",
                response.StatusCode, response.ReasonPhrase);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Logger.LogInformation("Upload successful. Response content: {ResponseContent}", responseContent);

                uploadMessage = $"Successfully uploaded {selectedFiles.Count} file(s).";
                uploadSuccess = true;
                selectedFiles.Clear();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("Upload failed. StatusCode: {StatusCode}, ReasonPhrase: {ReasonPhrase}, ErrorContent: {ErrorContent}",
                    response.StatusCode, response.ReasonPhrase, errorContent);

                uploadMessage = $"Upload failed with status: {response.StatusCode}. {response.ReasonPhrase}";
                uploadSuccess = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception occurred during file upload. Exception type: {ExceptionType}, Message: {ExceptionMessage}",
                ex.GetType().Name, ex.Message);

            uploadMessage = $"Upload failed: {ex.Message}";
            uploadSuccess = false;
        }
        finally
        {
            isUploading = false;
            Logger.LogInformation("File upload process completed. Success: {UploadSuccess}", uploadSuccess);
            StateHasChanged();
        }
    }

    private string FormatFileSize(long bytes)
    {
        const int scale = 1024;
        string[] orders = { "GB", "MB", "KB", "Bytes" };
        long max = (long)Math.Pow(scale, orders.Length - 1);

        foreach (string order in orders)
        {
            if (bytes > max)
                return $"{decimal.Divide(bytes, max):##.##} {order}";

            max /= scale;
        }
        return "0 Bytes";
    }
}